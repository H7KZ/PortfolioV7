{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BUILD_STANDALONE", "NUXT_*", "PAYLOAD_*", "DATABASE_URI"],
      "outputs": ["dist/**", ".output/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {
      "cache": false
    }
  }
}
