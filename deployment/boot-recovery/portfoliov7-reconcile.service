[Unit]
Description=Reconcile PortfolioV7 current release snapshots
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/portfoliov7-release.conf
ExecStart=/bin/bash /opt/portfoliov7-deployment/boot-recovery/reconcile.sh
TimeoutStartSec=90min
UMask=0077

[Install]
WantedBy=multi-user.target
