{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/", "http://localhost:3000/projects/kreditozrouti", "http://localhost:3000/resume", "http://localhost:3000/contact"],
      "numberOfRuns": 1,
      "settings": { "formFactor": "mobile", "throttlingMethod": "simulate" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./tests/redesign/out/lighthouse" }
  }
}
