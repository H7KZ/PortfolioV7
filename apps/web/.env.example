# Local development. Every value has a working default in nuxt.config.ts except the two keys,
# which scripts/migrate-v6.ts creates from CMS_READ_API_KEY / CMS_CONTACT_API_KEY.
NUXT_CMS_READ_API_KEY=local-reader-key-0000000000000000
NUXT_CMS_CONTACT_API_KEY=local-contact-key-000000000000000

# NUXT_CMS_INTERNAL_URL=http://localhost:43000
# NUXT_PREVIEW_SECRET=local-preview-secret
# NUXT_REVALIDATE_SECRET=local-revalidate-secret
# NUXT_PUBLIC_SITE_URL=http://localhost:45173
# NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# NUXT_PUBLIC_NOINDEX=false
