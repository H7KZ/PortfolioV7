{
  "name": "@portfolio/cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 43000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 43000",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:v6": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migrate-v6.ts",
    "seed:v7": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-v7.ts",
    "admin:create": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/create-local-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^10.1.0",
    "graphql": "^16.11.0",
    "next": "16.4.1",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "shiki": "^4.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "typescript": "catalog:"
  }
}
