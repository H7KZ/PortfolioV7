# Local development needs none of these: src/config.ts has local defaults and only
# production refuses to start without them.
# DATABASE_URI=postgres://portfolio:portfolio@127.0.0.1:45432/portfolio
# PAYLOAD_SECRET=local-development-secret
# CMS_URL=http://localhost:43000
# SITE_URL=http://localhost:45173
# PREVIEW_SECRET=local-preview-secret
# REVALIDATE_SECRET=local-revalidate-secret
# REVALIDATE_URLS=http://localhost:45173/_internal/revalidate
# DISCORD_WEBHOOK_URL=
# MEDIA_DIR=

# Only read by `pnpm migrate:v6`, which creates the API-key users the web authenticates with.
# CMS_READ_API_KEY=local-reader-key-0000000000000000
# CMS_CONTACT_API_KEY=local-contact-key-000000000000000
# V6_DIR=../../../../PortfolioV6
