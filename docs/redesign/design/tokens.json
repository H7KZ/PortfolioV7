  "color": {
    "bg": {
      "$type": "color",
      "$value": "#0b0d10",
      "$description": "Page background"
    },
    "surface": {
      "$type": "color",
      "$value": "#111419",
      "$description": "Cards, panels"
    },
    "surface-2": {
      "$type": "color",
      "$value": "#171b21",
      "$description": "Nested surfaces, inputs on cards, diagram nodes"
    },
    "line": {
      "$type": "color",
      "$value": "#1f252c",
      "$description": "Hairlines, card borders"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#2e3640",
      "$description": "Stronger dividers, node borders"
    },
    "ink": {
      "$type": "color",
      "$value": "#f1f3f5",
      "$description": "Primary text"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#c9cfd6",
      "$description": "Body copy"
    },
